{
  "model": "claude-sonnet-5-5",
  "permissionMode": "acceptEdits",
  "commands": {
    "enabled": true
  },
  "skills": {
    "enabled": true
  },
  "hooks": {
    "enabled": true
  },
  "agents": {
    "enabled": true
  },
  "deny": {
    "read": [
      "**/*.env",
      "**/*.env.*",
      "data/*.db",
      "**/*.log"
    ],
    "write": [
      "**/*.env",
      "**/*.env.*"
    ],
    "bash": [
      "rm -rf /",
      "rm -rf *",
      "format C:",
      "> .env"
    ]
  },
  "defaultBranch": "main",
  "autoCompact": {
    "enabled": true,
    "threshold": 0.8
  },
  "modelSelection": {
    "default": "claude-sonnet-5-5",
    "architect": "claude-opus-5-5",
    "code-reviewer": "claude-sonnet-5-5",
    "test-writer": "claude-sonnet-5-5",
    "fastTasks": "claude-haiku-5-5"
  }
}
